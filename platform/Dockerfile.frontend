# DKMV Platform frontend image (React 18 + Vite + TypeScript).
#
# This image runs the Vite DEV server (it proxies `/api` → the backend and injects
# the local control-plane token — see vite.config.ts). A hardened production static
# build (multi-stage + a static file server behind the loopback bind) is a post-v1
# deployment hardening item; v1 ships the dev server, which is sufficient for the
# loopback, single-operator control plane.
#
# Build context is the repo root (matches docker-compose.yml `context: ..`):
#   docker build -f platform/Dockerfile.frontend -t dkmv-platform-frontend .

FROM node:20-slim

ENV NODE_ENV=development

WORKDIR /app

# Install deps first for layer caching. Copy ONLY the manifest + lockfile so this
# layer stays cached as long as dependencies are unchanged. `npm ci` is
# deterministic (installs the committed package-lock.json exactly) and fails fast
# if the manifest and lockfile are out of sync — no `|| npm install` fallback,
# which would silently paper over a drifted/missing lockfile.
COPY platform/frontend/package.json platform/frontend/package-lock.json ./
RUN npm ci

# Copy the frontend source over the cached deps. The repo-root `.dockerignore`
# excludes `node_modules`, so this COPY no longer drags the host-built (wrong
# arch, ~74M) node_modules into the image and clobbers the deps installed above.
COPY platform/frontend/ ./

EXPOSE 5173

# Bind to 0.0.0.0 inside the container; compose publishes to host loopback only.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
