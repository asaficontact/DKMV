# DKMV Platform frontend — dev-server config (read by vite.config.ts at startup).
# Copy to `.env` for local `npm run dev`. These are Node-side only: they configure
# the Vite dev proxy and are NEVER bundled into the browser app (INV-1).

# The local control-plane token. MUST match the backend's DKMV_PLATFORM_TOKEN.
# The Vite proxy injects it as `Authorization: Bearer <token>` on every proxied
# `/api` request, so the browser app never holds the token.
DKMV_PLATFORM_TOKEN=

# Where the Vite dev server proxies `/api` → the backend. Defaults to the local
# loopback bind; override only if the backend runs elsewhere (e.g. a remote dev box).
DKMV_BACKEND_ORIGIN=http://127.0.0.1:8787
