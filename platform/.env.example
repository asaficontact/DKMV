# DKMV Platform — consolidated config/env surface (PRD §8.8).
# Copy to `.env` and fill in. In real deployments, secrets live in the encrypted
# SecretStore (PRD §8.6), not plain env.

# --- App access / auth (INV-1) ---
# Local auth token required on every API/SSE request. Generate a strong random value.
DKMV_PLATFORM_TOKEN=
# host:port the backend binds to. Loopback only by default.
DKMV_PLATFORM_BIND=127.0.0.1:8787

# --- Persistence + artifacts ---
DATABASE_URL=sqlite:///./data/dkmv.db
# Platform-owned engine runs/artifacts volume (OQ-4).
OUTPUT_DIR=./data/outputs

# --- Provider / engine credentials (secrets — keep out of source control) ---
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
CODEX_API_KEY=

# --- Sandbox image / runtime (INV-3) ---
DKMV_IMAGE=dkmv-sandbox:latest
# Container runtime. gVisor 'runsc' by default; weaker isolation requires an
# explicit opt-in + warning (OQ-6).
SANDBOX_RUNTIME=runsc

# --- Admission control / governance (consumed in Phase 3) ---
MAX_CONCURRENT_RUNS=3
# Total host memory budget for sandbox admission, e.g. 32g (optional).
HOST_MEMORY_BUDGET=
# Daily USD spend cap; leave empty to disable.
DAILY_SPEND_CAP=

# --- Orchestrator timing (consumed in Phase 3) ---
TICK_INTERVAL_S=10
STALL_TIMEOUT_S=300
PAUSE_TIMEOUT_S=3600

# --- Egress allowlist (INV-3): GitHub + model APIs only, comma-separated ---
EGRESS_ALLOWLIST=api.github.com,github.com,api.anthropic.com,api.openai.com
