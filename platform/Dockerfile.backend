# DKMV Platform backend image.
#
# Build context is the *repo root* (one level above platform/) so the image can
# editable-install the locked engine (`dkmv/`) alongside the backend — the
# backend imports `dkmv.runtime.EmbeddedRuntime` in-process (INV-13), never the
# CLI. Python is pinned >= 3.12 per PRD §8.8.
#
# Build from the repo root:
#   docker build -f platform/Dockerfile.backend -t dkmv-platform-backend .

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Copy the engine (locked, consumed in-process) and the platform backend.
# The engine's pyproject.toml declares `readme = "README.md"`, which lives at
# the repo-root alongside pyproject.toml — copy it too, or hatchling's metadata
# generation fails with `OSError: Readme file does not exist`.
COPY dkmv/ /src/dkmv/
COPY pyproject.toml /src/
COPY README.md /src/
COPY platform/backend/ /app/
# The backend's pyproject.toml declares `readme = "../README.md"` (i.e.
# platform/README.md); place it where `/app/pyproject.toml` resolves `..`.
COPY platform/README.md /README.md

# Editable-install the engine + the backend.
#
# Pin the build toolchain explicitly and disable PEP 517 build isolation for the
# engine so its UNPINNED `requires = ["hatchling"]` build backend cannot resolve
# an arbitrary (possibly PEP-660-incompatible) hatchling inside an ephemeral
# overlay. With a modern pip (>=23.1) defaulting to PEP 660 editable installs,
# we pre-install a known-good hatchling/editables here and reuse it via
# --no-build-isolation. This is a PLATFORM-SIDE fix only — the locked engine
# (dkmv/) and its pyproject.toml are never modified (INV-13).
RUN pip install --no-cache-dir "pip==24.3.1" \
    && pip install --no-cache-dir "hatchling==1.27.0" "editables>=0.5" \
    && pip install --no-cache-dir --no-build-isolation -e /src \
    && pip install --no-cache-dir --no-build-isolation -e /app

# The backend reaches Docker through a BROKERED socket (method-allowlisted proxy
# / rootless / Sysbox), wired in docker-compose.yml — never a raw
# `-v /var/run/docker.sock` mount (the Docker API is root-equivalent). The
# broker service lands in the 0.4-executor slice.
#
# ── Supply-chain: SBOM generate + scan + digest pin (§8.6, ADR-P005, AC-13) ──
# Both the platform backend image (built here) AND the `dkmv-sandbox` image the
# engine launches runs in are subject to an SBOM generate + vulnerability scan
# (Trivy / Docker Scout) before release, and are consumed BY DIGEST, never by a
# mutable `:latest` tag. The scan + digest-pin step is `platform/scripts/sbom-scan.sh`:
#   bash platform/scripts/sbom-scan.sh dkmv-sandbox:build   # SBOM + scan
#   eval "$(bash platform/scripts/sbom-scan.sh --print-digest-env)"  # -> DKMV_IMAGE=dkmv-sandbox@sha256:<digest>
# CI wires the script as a gate (fail on HIGH/CRITICAL). docker-compose.yml pins
# the sandbox image to `dkmv-sandbox@sha256:<digest>` (never `:latest`). See
# platform/README.md + platform/docs/setup.md for the full build → scan → pin flow.
#
# Pinning the BASE image by digest as well (defense-in-depth): replace the
# `python:3.12-slim` tag above with `python:3.12-slim@sha256:<digest>` resolved by
# the same scan script in a hardened build (documented in setup.md; left as the
# tag here so a fresh checkout still builds without a pre-resolved digest).

EXPOSE 8787

# Bind from DKMV_PLATFORM_BIND (default 127.0.0.1:8787). Inside the container
# the app binds 0.0.0.0 so compose can publish it to the host loopback; the
# host-side publish in docker-compose.yml restricts it to 127.0.0.1.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8787"]
